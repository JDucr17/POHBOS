---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  variant?: "compact" | "sidebar";
}

const { headings, variant = "sidebar" } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  items.length > 0 && variant === "compact" && (
    <details class="toc-compact">
      <summary>On this page</summary>
      <ul class="toc-compact-list">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class:list={["toc-compact-link", h.depth === 3 && "toc-compact-link--nested"]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

{
  items.length > 0 && variant === "sidebar" && (
    <nav aria-label="On this page" class="toc ml-auto">
      <div class="sticky top-8 pb-12">
        <p class="toc-label text-muted-foreground mb-4">On this page</p>
        <ul class="border-border flex flex-col border-l">
          {items.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link
                class:list={["toc-link block py-1.5", h.depth === 3 && "toc-link--nested"]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<style>
  .toc-compact {
    margin: -0.25rem 0 2rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: color-mix(in oklch, var(--muted) 40%, var(--card));
  }

  .toc-compact summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 1rem;
    color: var(--foreground);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .toc-compact summary::-webkit-details-marker {
    display: none;
  }

  .toc-compact summary::after {
    content: "+";
    color: var(--muted-foreground);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1rem;
    line-height: 1;
  }

  .toc-compact[open] summary {
    border-bottom: 1px solid var(--border);
  }

  .toc-compact[open] summary::after {
    content: "−";
  }

  .toc-compact-list {
    padding: 0.55rem 0.75rem 0.7rem;
  }

  .toc-compact-link {
    display: block;
    padding: 0.35rem 0.3rem;
    color: var(--muted-foreground);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .toc-compact-link:hover {
    color: var(--doc-accent);
  }

  .toc-compact-link--nested {
    padding-left: 1.2rem;
  }

  .toc-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .toc-link {
    color: var(--muted-foreground);
    margin-left: -1px;
    padding-left: 0.75rem;
    border-left: 2px solid transparent;
    font-size: 0.78rem;
    line-height: 1.35;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .toc-link--nested {
    padding-left: 1.25rem;
  }

  .toc-link:hover {
    color: var(--foreground);
  }

  .toc-link[data-active] {
    color: var(--doc-accent);
    border-left-color: var(--doc-accent);
    font-weight: 600;
  }

  .toc {
    display: none;
    width: 11rem;
  }

  @media (min-width: 72rem) {
    .toc {
      display: block;
    }

    .toc-compact {
      display: none;
    }
  }

  @media (min-width: 96rem) {
    .toc {
      width: 14rem;
    }

    .toc-link {
      padding-left: 1rem;
      font-size: 0.875rem;
    }

    .toc-link--nested {
      padding-left: 1.75rem;
    }
  }

  @media (min-width: 110rem) {
    .toc {
      width: 17rem;
    }
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));

  const entries = links
    .map((link) => {
      const id = decodeURIComponent((link.getAttribute("href") ?? "").slice(1));
      return { link, el: document.getElementById(id) };
    })
    .filter((entry): entry is { link: HTMLAnchorElement; el: HTMLElement } => Boolean(entry.el));

  const firstEntry = entries[0];

  if (firstEntry) {
    const OFFSET = 120;

    let active: HTMLAnchorElement | null = null;

    const setActive = (link: HTMLAnchorElement) => {
      if (link === active) return;

      active?.removeAttribute("data-active");
      link.setAttribute("data-active", "");
      active = link;
    };

    let navigationTarget: HTMLAnchorElement | null = null;

    for (const link of links) {
      link.addEventListener("click", () => {
        navigationTarget = link;
        setActive(link);
      });
    }

    let ticking = false;

    const update = () => {
      ticking = false;

      if (navigationTarget) {
        setActive(navigationTarget);
        return;
      }

      let current = firstEntry.link;

      for (const { link, el } of entries) {
        if (el.getBoundingClientRect().top <= OFFSET) {
          current = link;
        } else {
          break;
        }
      }

      setActive(current);
    };

    const onScroll = () => {
      if (ticking) return;

      ticking = true;
      requestAnimationFrame(update);
    };

    const releaseNavigationTarget = () => {
      if (!navigationTarget) return;

      navigationTarget = null;
      onScroll();
    };

    const scrollKeys = new Set(["ArrowDown", "ArrowUp", "End", "Home", "PageDown", "PageUp", " "]);

    window.addEventListener("wheel", releaseNavigationTarget, { passive: true });
    window.addEventListener("touchstart", releaseNavigationTarget, { passive: true });
    window.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-toc-link]")) return;
      releaseNavigationTarget();
    });
    window.addEventListener("keydown", (event) => {
      if (scrollKeys.has(event.key)) releaseNavigationTarget();
    });

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }
</script>
