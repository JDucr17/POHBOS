---
interface Item {
  name: string;
  desc: string;
}

interface Props {
  title?: string;
  items: Item[];
}

const { title, items } = Astro.props;
---

<div class="my-5">
  {title && <p class="mb-2 text-sm font-semibold text-foreground">{title}</p>}
  <dl class="overflow-hidden rounded-lg border border-border">
    {
      items.map((item, i) => (
        <div
          class:list={[
            "flex flex-col gap-0.5 px-4 py-2.5 sm:flex-row sm:items-baseline sm:gap-4",
            i > 0 && "border-t border-border",
          ]}
        >
          <dt class="font-mono text-[13px] text-primary sm:w-56 sm:shrink-0">
            {item.name}
          </dt>
          <dd class="text-sm text-muted-foreground">{item.desc}</dd>
        </div>
      ))
    }
  </dl>
</div>
