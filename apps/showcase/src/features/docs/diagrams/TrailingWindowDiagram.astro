---
import MobileProcessDiagram from "./MobileProcessDiagram.astro";

const mobileSteps = [
  { title: "Maintain the trailing window", description: "At 12:05, retain events from the most recent five minutes and age out events at or before 12:00.", tone: "cold" },
  { title: "Advance with event time", description: "The window slides forward as each accepted event joins the visitor's timeline.", tone: "flow" },
  { title: "Check cadence", description: "Wait 60 seconds after the previous score; the 12:05 event is eligible and the next earliest score is 12:06.", tone: "primary" },
  { title: "Check event count", description: "Score only when the trailing window also contains the configured minimum number of events.", tone: "warning" },
  { title: "Score the window", description: "The current window is scored only when both the cadence and minimum-event gates are open.", tone: "success" },
] as const;
---

<figure class="trailing-window-diagram">
  <svg
    viewBox="0 0 1200 850"
    width="100%"
    role="img"
    aria-labelledby="trailing-window-title trailing-window-desc"
  >
    <title id="trailing-window-title">Trailing window scoring model</title>
    <desc id="trailing-window-desc">
      A timeline showing events entering and aging out of a five-minute trailing
      window, followed by cadence and minimum-event gates that determine whether
      the current event is eligible to score.
    </desc>

    <defs>
      <marker
        id="timeline-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="fill-muted" />
      </marker>
      <marker
        id="span-arrow"
        viewBox="0 0 10 10"
        refX="5"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="fill-accent" />
      </marker>
    </defs>

    <rect x="1" y="1" width="1198" height="848" rx="18" class="card" />

    <g aria-label="Trailing window explanation">
      <rect x="235" y="30" width="730" height="76" rx="10" class="note" />
      <circle cx="282" cy="68" r="20" class="accent-outline" />
      <path d="M273 68h18m-7-7 7 7-7 7" class="accent-stroke" />
      <text x="322" y="61" class="body strong">
        The trailing window includes the most recent events
      </text>
      <text x="322" y="84" class="body strong">
        and slides forward over time.
      </text>
    </g>

    <g aria-label="Five-minute event timeline">
      <text x="620" y="137" text-anchor="middle" class="label accent-text">
        Window length = 5 min
      </text>
      <text x="620" y="160" text-anchor="middle" class="small muted-text">
        Trailing window: last 5 minutes
      </text>
      <line
        x1="310"
        y1="184"
        x2="930"
        y2="184"
        class="accent-stroke"
        marker-start="url(#span-arrow)"
        marker-end="url(#span-arrow)"
      />

      <path d="M65 214v-9q0-8 8-8h187q8 0 8 8v9" class="muted-stroke" />
      <text x="166" y="184" text-anchor="middle" class="small muted-text">
        Older events age out
      </text>

      <rect x="310" y="220" width="620" height="80" rx="8" class="window-band" />
      <line
        x1="45"
        y1="260"
        x2="1145"
        y2="260"
        class="timeline"
        marker-end="url(#timeline-arrow)"
      />
      <line x1="310" y1="198" x2="310" y2="324" class="boundary" />
      <line x1="930" y1="158" x2="930" y2="174" class="boundary" />
      <line x1="930" y1="197" x2="930" y2="225" class="boundary" />

      <circle cx="105" cy="260" r="10" class="aged-event" />
      <circle cx="105" cy="260" r="17" class="aged-ring" />
      <circle cx="210" cy="260" r="9" class="aged-event" />

      <circle cx="370" cy="260" r="9" class="active-event" />
      <circle cx="510" cy="260" r="9" class="active-event" />
      <circle cx="650" cy="260" r="9" class="active-event" />
      <circle cx="790" cy="260" r="9" class="active-event" />
      <circle cx="930" cy="260" r="12" class="current-event" />
      <circle cx="930" cy="260" r="20" class="current-ring" />
      <circle cx="930" cy="260" r="27" class="current-ring soft" />
      <circle cx="1055" cy="260" r="9" class="future-event" />

      <text x="105" y="306" text-anchor="middle" class="time">11:59</text>
      <text x="105" y="328" text-anchor="middle" class="small muted-text">aged out</text>
      <text x="210" y="306" text-anchor="middle" class="time">12:00</text>
      <text x="210" y="328" text-anchor="middle" class="small muted-text">aged out</text>
      <text x="370" y="306" text-anchor="middle" class="time">12:01</text>
      <text x="510" y="306" text-anchor="middle" class="time">12:02</text>
      <text x="650" y="306" text-anchor="middle" class="time">12:03</text>
      <text x="790" y="306" text-anchor="middle" class="time">12:04</text>
      <text x="930" y="306" text-anchor="middle" class="time accent-text">12:05</text>
      <text x="1055" y="306" text-anchor="middle" class="time muted-text">12:06</text>

      <text x="930" y="137" text-anchor="middle" class="label accent-text">
        Current event = 12:05
      </text>
      <text x="310" y="351" text-anchor="middle" class="small accent-text">
        Window start
      </text>
      <text x="310" y="372" text-anchor="middle" class="small accent-text">12:00</text>

      <path d="M376 346v8q0 8 8 8h238q8 0 8 8 0-8 8-8h278q8 0 8-8v-8" class="flow-stroke" />
      <text x="650" y="397" text-anchor="middle" class="label flow-text">
        Events inside window
      </text>
      <text x="650" y="421" text-anchor="middle" class="small">
        12:01, 12:02, 12:03, 12:04, 12:05
        <tspan class="flow-text strong"> (5 events)</tspan>
      </text>
    </g>

    <line x1="45" y1="458" x2="1155" y2="458" class="divider" />

    <g aria-label="Cadence gate">
      <circle cx="78" cy="535" r="29" class="flow-outline" />
      <circle cx="78" cy="535" r="18" class="flow-outline" />
      <path d="M78 524v12l9 6" class="flow-stroke" />
      <text x="122" y="520" class="label flow-text">Cadence gate</text>
      <text x="122" y="544" class="small">The detector waits a fixed interval</text>
      <text x="122" y="565" class="small">of 60s before scoring the visitor again.</text>

      <line x1="390" y1="535" x2="1110" y2="535" class="cadence-line" />
      <circle cx="470" cy="535" r="7" class="active-event" />
      <circle cx="750" cy="535" r="7" class="active-event" />
      <circle cx="1030" cy="535" r="7" class="active-event" />

      <text x="470" y="505" text-anchor="middle" class="time">12:04</text>
      <text x="750" y="505" text-anchor="middle" class="time">12:05</text>
      <text x="1030" y="505" text-anchor="middle" class="time">12:06</text>
      <text x="470" y="572" text-anchor="middle" class="small">Last score</text>
      <text x="750" y="572" text-anchor="middle" class="small">Current event</text>
      <text x="750" y="592" text-anchor="middle" class="small flow-text">eligible to score</text>
      <text x="1030" y="572" text-anchor="middle" class="small">Next score earliest</text>

      <path d="M462 608l6 6 12-14" class="flow-stroke" />
      <path d="M742 608l6 6 12-14" class="flow-stroke" />
      <path d="M1022 608l6 6 12-14" class="flow-stroke" />
    </g>

    <g aria-label="Minimum event gate">
      <circle cx="78" cy="686" r="29" class="accent-outline" />
      <path d="M65 700v-10m13 10v-21m13 21v-31" class="accent-stroke bars" />
      <text x="122" y="671" class="label accent-text">Minimum events</text>
      <text x="122" y="695" class="small">Score only when enough</text>
      <text x="122" y="716" class="small">events are in the window.</text>

      <text x="470" y="656" text-anchor="middle" class="small muted-text">Not enough</text>
      <rect x="375" y="670" width="190" height="48" rx="8" class="example muted-example" />
      <circle cx="408" cy="694" r="6" class="future-event" />
      <circle cx="455" cy="694" r="6" class="future-event" />
      <line x1="462" y1="738" x2="478" y2="754" class="muted-stroke" />
      <line x1="478" y1="738" x2="462" y2="754" class="muted-stroke" />

      <text x="710" y="656" text-anchor="middle" class="small muted-text">Not enough</text>
      <rect x="615" y="670" width="190" height="48" rx="8" class="example muted-example" />
      <circle cx="648" cy="694" r="6" class="future-event" />
      <circle cx="695" cy="694" r="6" class="active-event" />
      <circle cx="742" cy="694" r="6" class="active-event" />
      <line x1="702" y1="738" x2="718" y2="754" class="muted-stroke" />
      <line x1="718" y1="738" x2="702" y2="754" class="muted-stroke" />

      <text x="970" y="656" text-anchor="middle" class="small accent-text">
        Minimum events met (5 events)
      </text>
      <rect x="850" y="670" width="240" height="48" rx="8" class="example met-example" />
      <circle cx="882" cy="694" r="6" class="active-event" />
      <circle cx="927" cy="694" r="6" class="active-event" />
      <circle cx="972" cy="694" r="6" class="active-event" />
      <circle cx="1017" cy="694" r="6" class="active-event" />
      <circle cx="1062" cy="694" r="6" class="current-event" />
      <path d="M962 744l7 7 14-17" class="accent-stroke" />
    </g>

    <g aria-label="Scoring outcome">
      <rect x="205" y="785" width="790" height="44" rx="8" class="outcome" />
      <text x="600" y="813" text-anchor="middle" class="small">
        At <tspan class="accent-text strong">12:05</tspan>, the window contains 5 events → cadence gate is open → minimum events met →
        <tspan class="accent-text strong"> score.</tspan>
      </text>
    </g>
  </svg>
</figure>

<MobileProcessDiagram
  title="Trailing window scoring model"
  description="Event-time windowing and two explicit gates determine when a visitor is eligible to score."
  steps={[...mobileSteps]}
/>

<style>
  .trailing-window-diagram {
    margin: 2rem 0 2.5rem;
  }

  svg {
    display: block;
    height: auto;
    font-family: inherit;
  }

  .card {
    fill: var(--card);
    stroke: var(--border);
  }

  .note,
  .outcome {
    fill: var(--card);
    stroke: color-mix(in oklch, var(--doc-accent) 30%, var(--border));
  }

  .window-band {
    fill: color-mix(in oklch, var(--flow) 6%, transparent);
  }

  .body,
  .label,
  .small,
  .time {
    fill: var(--foreground);
  }

  .body {
    font-size: 17px;
  }

  .label {
    font-size: 16px;
    font-weight: 600;
  }

  .small {
    font-size: 14px;
  }

  .time {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 14px;
    font-weight: 600;
  }

  .strong {
    font-weight: 600;
  }

  .muted-text {
    fill: var(--muted-foreground);
  }

  .accent-text {
    fill: var(--doc-accent);
  }

  .flow-text {
    fill: var(--flow);
  }

  .timeline,
  .divider,
  .muted-stroke,
  .accent-stroke,
  .flow-stroke,
  .boundary,
  .cadence-line,
  .accent-outline,
  .flow-outline,
  .aged-ring,
  .current-ring,
  .example {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .timeline,
  .muted-stroke {
    stroke: var(--muted-foreground);
    stroke-width: 1.5;
  }

  .divider {
    stroke: var(--border);
  }

  .accent-stroke,
  .accent-outline,
  .current-ring {
    stroke: var(--doc-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .flow-stroke,
  .flow-outline {
    stroke: var(--flow);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .boundary {
    stroke: var(--doc-accent);
    stroke-width: 1.5;
    stroke-dasharray: 7 7;
  }

  .cadence-line {
    stroke: var(--flow);
    stroke-width: 1.5;
    stroke-dasharray: 7 7;
  }

  .aged-ring {
    stroke: var(--muted-foreground);
    stroke-dasharray: 4 4;
  }

  .current-ring.soft {
    opacity: 0.4;
  }

  .aged-event,
  .future-event,
  .fill-muted {
    fill: var(--muted-foreground);
  }

  .active-event {
    fill: var(--flow);
  }

  .current-event,
  .fill-accent {
    fill: var(--doc-accent);
  }

  .muted-example {
    stroke: var(--muted-foreground);
    stroke-dasharray: 5 5;
  }

  .met-example {
    fill: color-mix(in oklch, var(--doc-accent) 5%, transparent);
    stroke: color-mix(in oklch, var(--doc-accent) 55%, var(--border));
    stroke-dasharray: 5 5;
  }

  .bars {
    stroke-width: 5;
  }

  @media (max-width: 48rem) {
    .trailing-window-diagram {
      display: none;
    }
  }
</style>
