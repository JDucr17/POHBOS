---
import {
  ArrowLeft,
  LogIn,
  Inbox,
  AudioWaveform,
  Target,
  Search,
  FileText,
  Info,
  type Icon as IconType,
} from "@lucide/astro";
import SidebarToggle from "@/features/navigation/SidebarToggle.svelte";
import Wordmark from "@/features/brand/Wordmark.astro";

interface NavItem {
  label: string;
  href: string;
  icon: typeof IconType;
}

const navGroups: { label: string; items: NavItem[] }[] = [
  {
    label: "Concepts",
    items: [
      { label: "About", href: "/about", icon: Info },
      { label: "How Scoring Works", href: "/scoring", icon: FileText },
    ],
  },
  {
    label: "Services",
    items: [
      { label: "Ingestor", href: "/services/ingestor", icon: LogIn },
      { label: "Sink", href: "/services/sink", icon: Inbox },
      {
        label: "Baseline Worker",
        href: "/services/baseline-worker",
        icon: AudioWaveform,
      },
      { label: "Detector", href: "/services/detector", icon: Target },
      { label: "Query API", href: "/services/query-api", icon: Search },
    ],
  },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<aside
  class="sidebar relative flex w-full flex-col bg-background md:sticky md:top-0 md:h-screen md:w-72 md:shrink-0 md:self-start"
>
  <div class="sidebar__header">
    <a href="/" class="flex items-center">
      <Wordmark
        class="text-2xl font-semibold tracking-tight text-foreground italic"
      />
    </a>
    <SidebarToggle client:load />
  </div>

  <a href="/" class="back-link">
    <ArrowLeft class="size-4" />
    Back to pipeline
  </a>

  <nav
    id="sidebar-nav"
    data-open="false"
    class="sidebar__nav hidden flex-1 overflow-y-auto data-[open=true]:block md:block"
  >
    {
      navGroups.map((group) => (
        <div class="nav-group">
          <p class="nav-group-label text-muted-foreground">{group.label}</p>
          <ul class="flex flex-col gap-1">
            {group.items.map((item) => {
              const active = current === item.href;
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? "page" : undefined}
                    class:list={["nav-item", active && "nav-item--active"]}
                  >
                    <span class="nav-item__icon" aria-hidden="true">
                      <item.icon size={16} stroke-width={2} />
                    </span>
                    <span class="nav-item__label">{item.label}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="sidebar__footer">
    <div class="sidebar__divider" />
    <p class="sidebar__version">POHBOS Docs • v1.0</p>
  </div>
</aside>

<style>
  .sidebar {
    --gutter: 1.25rem;
    --pad: 0.6rem;
  }

  .sidebar::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--card) 0%,
      var(--glow-blue) 18%,
      var(--glow-blue) 82%,
      var(--card) 100%
    );
  }

  .sidebar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2.25rem var(--gutter) 1.5rem;
  }

  .back-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.5rem;
    margin: 0 var(--gutter) 1.75rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--foreground);
  }

  .sidebar__nav {
    padding: 0 calc(var(--gutter) - var(--pad)) 1.5rem;
  }

  .nav-group + .nav-group {
    margin-top: 2rem;
  }

  .nav-group-label {
    padding: 0 0 0.75rem var(--pad);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem var(--pad);
    border-radius: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted-foreground);
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .nav-item:hover {
    color: var(--foreground);
    background: color-mix(in oklch, var(--foreground) 4%, transparent);
  }

  .nav-item__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 0.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .nav-item__icon :global(svg) {
    display: block;
  }

  .nav-item--active {
    color: var(--glow-blue);
    font-weight: 600;
    background: color-mix(in oklch, var(--glow-blue) 9%, transparent);
  }

  .nav-item--active::before {
    content: "";
    position: absolute;
    left: calc(-1 * (var(--gutter) - var(--pad)));
    top: 0.35rem;
    bottom: 0.35rem;
    width: 3px;
    border-radius: 0 2px 2px 0;
    background: var(--glow-blue);
  }

  .nav-item--active .nav-item__icon {
    color: var(--glow-blue);
    background: color-mix(in oklch, var(--glow-blue) 14%, var(--card));
    border-color: color-mix(in oklch, var(--glow-blue) 30%, var(--border));
  }

  .sidebar__footer {
    margin-top: auto;
    padding: 1rem var(--gutter) 1.5rem;
  }

  .sidebar__divider {
    margin-bottom: 1rem;
    border-top: 1px solid var(--border);
  }

  .sidebar__version {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
</style>
