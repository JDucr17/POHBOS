---
import Wordmark from "@/features/brand/Wordmark.astro";
import AnimatedDivider from "@/lib/components/AnimatedDivider.astro";

interface NavigationItem {
  label: string;
  href: string;
}

const navigationItems: NavigationItem[] = [
  { label: "Home", href: "/" },
  { label: "Analytics", href: "/analytics" },
  { label: "Docs", href: "/docs/scoring" },
];

const githubUrl = "https://github.com/JDucr17/Streamline";
const linkedinUrl = "https://www.linkedin.com/in/jose-daniel-ramirez-reyes-sw/";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="bg-background sticky top-0 z-50 shrink-0">
  <nav
    class="flex h-20 w-full items-center justify-between px-4 sm:px-6 lg:px-8"
    aria-label="Primary navigation"
  >
    <a
      href="/"
      aria-label="POHBOS home"
      class="focus-visible:ring-ring rounded-md focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      <Wordmark class="text-foreground text-3xl font-semibold tracking-tight italic" />
    </a>

    <div class="hidden items-center gap-1 md:flex">
      <ul class="flex items-center gap-1">
        {
          navigationItems.map((item) => {
            const active = currentPath === item.href;

            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "focus-visible:ring-ring inline-flex h-9 items-center rounded-md px-3 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:outline-none",
                    active
                      ? "text-primary"
                      : "text-muted-foreground hover:bg-muted hover:text-foreground",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="POHBOS on GitHub"
        class="text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:ring-ring ml-2 inline-flex size-9 items-center justify-center rounded-md transition-colors focus-visible:ring-2 focus-visible:outline-none"
      >
        <svg class="size-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
      </a>

      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="POHBOS author on LinkedIn"
        class="text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:ring-ring inline-flex size-9 items-center justify-center rounded-md transition-colors focus-visible:ring-2 focus-visible:outline-none"
      >
        <svg class="size-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>
    </div>

    <details class="group relative md:hidden">
      <summary
        aria-label="Toggle navigation menu"
        class="text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:ring-ring inline-flex size-9 cursor-pointer list-none items-center justify-center rounded-md transition-colors focus-visible:ring-2 focus-visible:outline-none [&::-webkit-details-marker]:hidden"
      >
        <svg class="size-5 group-open:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <svg
          class="hidden size-5 group-open:block"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="m6 6 12 12M18 6 6 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </summary>

      <div class="border-border bg-background absolute top-14 right-0 w-52 rounded-lg border p-2">
        <ul class="flex flex-col gap-1">
          {
            navigationItems.map((item) => {
              const active = currentPath === item.href;

              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "focus-visible:ring-ring flex rounded-md px-3 py-2 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:outline-none",
                      active
                        ? "bg-muted text-primary"
                        : "text-muted-foreground hover:bg-muted hover:text-foreground",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
          <li class="border-border border-t pt-1">
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:ring-ring flex rounded-md px-3 py-2 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:outline-none"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href={linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:ring-ring flex rounded-md px-3 py-2 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:outline-none"
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
  <AnimatedDivider />
</header>
