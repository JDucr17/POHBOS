---
import Logo from "./logo.svg";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["inline-flex items-baseline gap-2.5", className]}>
  <Logo
    class="h-[0.93em] w-auto shrink-0 self-center text-primary"
    viewBox="247.118 354.508 792 481"
    aria-hidden="true"
  />
  <span>POHBOS</span>
</span>
