<style>
  .hero {
    --hero-surface-height: clamp(28rem, 50vh, 29.5rem);
    --hero-pipeline-gap: 1.25rem;
    --hero-grid-size: 34px;
    position: relative;
    z-index: 1;
    height: calc(var(--hero-surface-height) + var(--hero-pipeline-gap));
    isolation: isolate;
    background-color: var(--canvas-bg);
    background-image:
      linear-gradient(
        to right,
        color-mix(in oklch, var(--border) 50%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklch, var(--border) 50%, transparent) 1px,
        transparent 1px
      ),
      radial-gradient(
        circle,
        color-mix(in oklch, var(--muted-foreground) 50%, transparent) 1.5px,
        transparent 2px
      );
    background-position:
      0 0,
      0 0,
      calc(var(--hero-grid-size) / 2) calc(var(--hero-grid-size) / 2);
    background-size: var(--hero-grid-size) var(--hero-grid-size);
  }

  .hero-surface {
    position: absolute;
    inset: 0 0 auto;
    height: var(--hero-surface-height);
    overflow: hidden;
    background: var(--card);
  }

  .hero-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-lines {
    z-index: 1;
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in oklch, var(--primary) 12%, transparent) 0,
      color-mix(in oklch, var(--primary) 12%, transparent) 1px,
      transparent 1px,
      transparent 10px
    );
    opacity: 0.42;
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 18%), rgb(0 0 0 / 68%) 38%, #000 100%);
    -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 18%), rgb(0 0 0 / 68%) 38%, #000 100%);
  }

  .hero-trail {
    position: absolute;
    z-index: 3;
    top: 1.25rem;
    left: 38%;
    width: min(36vw, 38rem);
    height: auto;
    overflow: visible;
    pointer-events: none;
  }

  .trail-line {
    stroke: url("#trail-stroke");
    stroke-width: 1.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .trail-line--secondary {
    stroke: url("#trail-secondary-stroke");
    opacity: 0.74;
  }

  .trail-line--tertiary {
    stroke: url("#trail-tertiary-stroke");
    opacity: 0.72;
  }

  .trail-line--quaternary {
    stroke: url("#trail-stroke");
    opacity: 0.82;
  }

  .trail-halo {
    fill: var(--card);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .trail-halo--red {
    stroke: color-mix(in oklch, var(--risk-high) 34%, transparent);
  }

  .trail-halo--yellow {
    stroke: color-mix(in oklch, var(--risk-medium) 34%, transparent);
  }

  .trail-halo--teal {
    stroke: color-mix(in oklch, var(--cold-path) 34%, transparent);
  }

  .hero-orbit {
    position: absolute;
    z-index: 3;
    top: -4.5rem;
    right: -5.5rem;
    width: min(54vw, 56rem);
    height: auto;
    overflow: visible;
    pointer-events: none;
  }

  .orbit-axis {
    stroke: color-mix(in oklch, var(--flow) 9%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 13;
    vector-effect: non-scaling-stroke;
  }

  .orbit-ring,
  .orbit-arc {
    stroke: color-mix(in oklch, var(--primary) 25%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .orbit-ring--strong {
    stroke: color-mix(in oklch, var(--primary) 35%, transparent);
  }

  .orbit-ring--soft,
  .orbit-arc--soft {
    stroke: color-mix(in oklch, var(--primary) 18%, transparent);
  }

  .orbit-ring--faint {
    stroke: color-mix(in oklch, var(--flow) 13%, transparent);
  }

  .orbit-arc {
    stroke-linecap: round;
  }

  .orbit-core {
    fill: var(--card);
    stroke: color-mix(in oklch, var(--primary) 32%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .observation-halo {
    fill: transparent;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .observation-halo--green {
    stroke: color-mix(in oklch, var(--risk-low) 27%, transparent);
  }

  .observation-halo--yellow {
    stroke: color-mix(in oklch, var(--risk-medium) 27%, transparent);
  }

  .observation-halo--red {
    stroke: color-mix(in oklch, var(--risk-high) 27%, transparent);
  }

  .hero-dot {
    fill: var(--primary);
    opacity: 0.72;
  }

  .hero-dot--green {
    fill: var(--risk-low);
  }

  .hero-dot--yellow {
    fill: var(--risk-medium);
  }

  .hero-dot--red {
    fill: var(--risk-high);
  }

  .hero-dot--teal {
    fill: var(--cold-path);
  }

  .hero-dot--purple {
    fill: var(--sink);
  }

  .hero-dot--green,
  .hero-dot--yellow,
  .hero-dot--red,
  .hero-dot--teal,
  .hero-dot--purple {
    opacity: 0.68;
  }

  .hero-trail .hero-dot {
    opacity: 0.92;
    filter: drop-shadow(0 0 2.5px color-mix(in oklch, var(--primary) 82%, transparent))
      drop-shadow(0 0 6px color-mix(in oklch, var(--primary) 45%, transparent));
  }

  .hero-trail .hero-dot--green {
    filter: drop-shadow(0 0 2.5px color-mix(in oklch, var(--risk-low) 84%, transparent))
      drop-shadow(0 0 6px color-mix(in oklch, var(--risk-low) 46%, transparent));
  }

  .hero-trail .hero-dot--yellow {
    filter: drop-shadow(0 0 2.5px color-mix(in oklch, var(--risk-medium) 84%, transparent))
      drop-shadow(0 0 6px color-mix(in oklch, var(--risk-medium) 46%, transparent));
  }

  .hero-trail .hero-dot--red {
    filter: drop-shadow(0 0 2.5px color-mix(in oklch, var(--risk-high) 84%, transparent))
      drop-shadow(0 0 6px color-mix(in oklch, var(--risk-high) 46%, transparent));
  }

  .hero-trail .hero-dot--teal {
    filter: drop-shadow(0 0 2.5px color-mix(in oklch, var(--cold-path) 84%, transparent))
      drop-shadow(0 0 6px color-mix(in oklch, var(--cold-path) 46%, transparent));
  }

  .hero-trail .hero-dot--purple {
    filter: drop-shadow(0 0 2.5px color-mix(in oklch, var(--sink) 84%, transparent))
      drop-shadow(0 0 6px color-mix(in oklch, var(--sink) 46%, transparent));
  }

  .hero-content {
    position: relative;
    z-index: 4;
    width: 100%;
    padding: clamp(3.75rem, 7.5vh, 4.25rem) clamp(1.5rem, 5.35vw, 6rem) 1.5rem;
  }

  .hero-copy {
    max-width: 38rem;
  }

  .hero-title {
    margin: 0;
    color: var(--foreground);
    font-size: clamp(1.9rem, 2vw, 2.1rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.32;
  }

  .hero-title span {
    color: var(--primary);
  }

  .hero-subtitle {
    display: inline-flex;
    margin-top: 1.5rem;
    border-radius: 0.25rem;
    color: var(--primary);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.5;
    transition: color 150ms ease;
  }

  .hero-subtitle:hover {
    color: var(--primary-hover);
  }

  .hero-subtitle:focus-visible,
  .hero-primary-action:focus-visible,
  .hero-secondary-action:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero-primary-action,
  .hero-secondary-action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    padding: 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .hero-primary-action {
    background: var(--node-surface-top);
    color: var(--node-fg);
  }

  .hero-primary-action:hover {
    background: var(--node-surface);
  }

  .hero-secondary-action {
    color: var(--primary);
  }

  .hero-secondary-action:hover {
    background: var(--muted);
    color: var(--primary-hover);
  }

  .hero-horizon {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--hero-surface-height);
    overflow: visible;
    pointer-events: none;
  }

  .horizon-cutout {
    fill: var(--canvas-bg);
  }

  .horizon-edge {
    fill: none;
    stroke: var(--node-surface-top);
    opacity: 0.42;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  @media (max-width: 63.99rem) {
    .hero-trail {
      top: 5rem;
      left: 50%;
      width: 31rem;
      opacity: 0.58;
    }

    .hero-orbit {
      top: -2rem;
      right: -17rem;
      width: 45rem;
      opacity: 0.64;
    }

    .hero-copy {
      max-width: 34rem;
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      --hero-surface-height: 34rem;
      --hero-pipeline-gap: 0.75rem;
    }

    .hero-content {
      padding: 3.25rem 1.5rem 6rem;
    }

    .hero-title {
      font-size: clamp(1.75rem, 7vw, 2rem);
      line-height: 1.25;
    }

    .hero-trail {
      display: none;
    }

    .hero-orbit {
      top: 3rem;
      right: -23rem;
      width: 39rem;
      opacity: 0.34;
    }

    .hero-lines {
      opacity: 0.28;
      mask-image: linear-gradient(90deg, rgb(0 0 0 / 12%), rgb(0 0 0 / 58%) 76%, #000);
      -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 12%), rgb(0 0 0 / 58%) 76%, #000);
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-subtitle,
    .hero-primary-action,
    .hero-secondary-action {
      transition: none;
    }
  }
</style>
