---
import "@/styles/global.css";
import type { MarkdownHeading } from "astro";
import Sidebar from "@/features/navigation/Sidebar.astro";
import Footer from "@/features/navigation/Footer.astro";
import TableOfContents from "@/features/docs/TableOfContents.astro";
import CopyLink from "@/features/docs/CopyLink.astro";

interface Props {
  title: string;
  description?: string;
  accent?: "primary" | "flow" | "cold";
  section?: string;
  headings?: MarkdownHeading[];
}

const { title, description, accent = "primary", section, headings = [] } = Astro.props;

const accentVar =
  accent === "flow" ? "var(--flow)" : accent === "cold" ? "var(--cold-path)" : "var(--primary)";

const hasTableOfContents = headings.some((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-background flex min-h-screen flex-col">
    <div class="flex flex-1 flex-col md:flex-row md:items-start">
      <Sidebar />
      <main class="doc-main bg-card min-w-0 flex-1" style={`--doc-accent: ${accentVar};`}>
        <div
          class:list={["doc-content px-6 lg:px-12", hasTableOfContents && "doc-content--with-toc"]}
        >
          <article
            class:list={[
              "doc-article min-w-0 pt-10 pb-24",
              !hasTableOfContents && "doc-article--without-toc",
            ]}
          >
            <header class="mb-10 flex items-start justify-between gap-6">
              <div class="min-w-0">
                {section && <p class="doc-eyebrow">{section}</p>}
                <h1 class="doc-title">{title}</h1>
              </div>
              <CopyLink />
            </header>
            <TableOfContents headings={headings} variant="compact" />
            <slot />
          </article>
          <TableOfContents headings={headings} variant="sidebar" />
        </div>
      </main>
    </div>
    <Footer />
  </body>
</html>

<style>
  .doc-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--doc-accent);
    margin: 0 0 0.7rem;
  }

  .doc-title {
    font-size: 2.5rem;
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--foreground);
    margin: 0;
  }
  .doc-article {
    max-width: 54rem;
  }

  @media (min-width: 72rem) {
    .doc-content--with-toc {
      display: grid;
      grid-template-columns: minmax(0, 54rem) 11rem;
      column-gap: 2rem;
      justify-content: space-between;
    }

    .doc-content--with-toc .doc-article :global(.docs-prose figure) {
      width: 100%;
      max-width: 100%;
      margin-left: 0;
    }
  }

  @media (min-width: 96rem) {
    .doc-content--with-toc {
      grid-template-columns: minmax(0, 64rem) 14rem;
      column-gap: 4rem;
    }

    .doc-article {
      max-width: 64rem;
    }

    .doc-article--without-toc {
      max-width: 68rem;
    }
  }

  @media (min-width: 110rem) {
    .doc-content--with-toc {
      grid-template-columns: minmax(0, 64rem) 17rem;
    }
  }
</style>
