---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsProse from "@/features/docs/DocsProse.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("docs", "ingestor");
if (!entry) throw new Error("Missing docs entry: ingestor");
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  accent={entry.data.accent}
  section={entry.data.section}
  headings={headings}
>
  <DocsProse accent={entry.data.accent}>
    <Content />
  </DocsProse>
</DocsLayout>
