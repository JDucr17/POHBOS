---
import ImmersiveLayout from "@/layouts/ImmersiveLayout.astro";
import Pipeline from "@/features/pipeline/Pipeline.svelte";
import AnalyticsPreview from "@/features/home/AnalyticsPreview.astro";
import HomeHero from "@/features/home/HomeHero.astro";
import WipCard from "@/features/home/WipCard.astro";
import HomeHeader from "@/features/navigation/HomeHeader.astro";
import AnimatedDivider from "@/lib/components/AnimatedDivider.astro";
---

<ImmersiveLayout
  title="POHBOS"
  description="A behavioral anomaly detector: watch the streaming pipeline turn events into decisions in real time."
>
  <HomeHeader />

  <main class="flex-1">
    <HomeHero />
    <AnimatedDivider />

    <section class="w-full" aria-label="Pipeline visualization">
      <Pipeline client:load />
    </section>

    <AnalyticsPreview />

    <section class="mx-auto w-full max-w-6xl px-6 py-12 lg:px-12">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[55fr_45fr]">
        <WipCard
          title="Session crafter"
          description="This section will let visitors generate HTTP session behavior, send it through the ingestor, and watch how the detector responds."
        />
        <WipCard
          title="Live decision stream"
          description="This section will show decisions as they move through the Query API stream, including recent backfill and live updates from the pipeline."
        />
      </div>
    </section>
  </main>
</ImmersiveLayout>
