# ─────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=streamline
POSTGRES_PASSWORD=changeme
POSTGRES_DB=streamline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection string used by Go services and migration tooling.
# Uses the service names defined in compose.yaml.
DATABASE_URL=postgres://streamline:changeme@localhost:5432/streamline?sslmode=disable

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_URL_LOCAL=redis://localhost:6379/0

# RedisInsight web UI port
REDIS_INSIGHT_PORT=8001

# ─────────────────────────────────────────────────────────────
# Service ports
# ─────────────────────────────────────────────────────────────
EVENT_PROCESSOR_PORT=8080
QUERY_API_PORT=8081
ANALYTICS_PORT=9090
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

# ─────────────────────────────────────────────────────────────
# Application configuration
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENVIRONMENT=development