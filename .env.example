# ─────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=streamline
POSTGRES_PASSWORD=changeme
POSTGRES_DB=streamline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection string for Go services and migration tooling.
# Use localhost from the host; swap to the postgres service name in-container.
DATABASE_URL=postgres://streamline:changeme@localhost:5432/streamline?sslmode=disable

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# Host-exposed connection; use when running services from the host.
REDIS_URL=redis://localhost:6379/0
# Container-internal connection; use when services run inside Compose.
REDIS_URL_INTERNAL=redis://redis:6379/0

# RedisInsight web UI port
REDIS_INSIGHT_PORT=8001

# ─────────────────────────────────────────────────────────────
# Service ports
# ─────────────────────────────────────────────────────────────
EVENT_PROCESSOR_PORT=8080
ANALYTICS_PORT=9090
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

# ─────────────────────────────────────────────────────────────
# Application configuration
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────────────────────────

# Host-exposed listener, use when running Go services from the host.
KAFKA_BROKERS=localhost:19092

# Container-internal listener, use when services run inside Compose.
KAFKA_BROKERS_INTERNAL=redpanda:9092

# Redpanda host ports
REDPANDA_HOST_PORT=19092
REDPANDA_ADMIN_PORT=9644

# Topic names. Creation/config is handled by `make kafka-topics`
# (runs infra/kafka/create_topics.sh against the running broker).
KAFKA_RAW_EVENTS_TOPIC=raw_events
KAFKA_DECISIONS_TOPIC=decisions
KAFKA_DEAD_LETTER_TOPIC=dead_letter_events

# Local/demo retention: raw_events/decisions kept briefly (6h);
# dead_letter_events kept longer for debugging (set in create_topics.sh).
KAFKA_DEV_RETENTION_MS=21600000

# Consumer groups
DETECTOR_CONSUMER_GROUP=detector
SINK_EVENTS_CONSUMER_GROUP=event-sink
SINK_DECISIONS_CONSUMER_GROUP=decision-sink

# ─────────────────────────────────────────────────────────────
# Query API
# ─────────────────────────────────────────────────────────────
QUERY_API_HTTP_ADDR=:8083
QUERY_API_CONSUMER_GROUP=query-api
QUERY_VISITOR_TTL=30m
QUERY_RECENT_RING_CAPACITY=131072